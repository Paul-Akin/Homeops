<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup and device-transfer rules. HomeOps is local-first (DESIGN.md Section 9):
  nothing is copied to Google cloud backup or to a new phone automatically. Use the
  JSON export (M8) to move data deliberately.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
